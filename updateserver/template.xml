        <type>template</type>
        <client>site</client>
        <version>2.1.0</version>
        <infourl title="Italia Theme for Joomla">https://github.com/pcrt/italia-theme-for-joomla/releases/tag/v2.1.0</infourl>
        <downloads>
            <downloadurl type="full" format="zip">https://github.com/pcrt/italia-theme-for-joomla/releases/download/v2.1.0/joomla-italia-theme-2.1.0.zip</downloadurl>
        </downloads>
        <tags>
            <tag>stable</tag>
        </tags>
        <maintainer>Protocolli Creativi (pcrt)</maintainer>
        <maintainerurl>https://www.protocollicreativi.it</maintainerurl>
        <targetplatform name="joomla" version="(5\.[0-9]+|6\.[0-9]+)"/>
        <php_minimum>8.1</php_minimum>
    </update>
